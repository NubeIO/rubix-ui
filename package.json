{
  "name": "@nube/rubix-ui",
  "version": "0.6.0",
  "description": "The Rubix design system's components \u2014 the buttons, fields, cards and tables the rubix-ai app is built from \u2014 published so an extension UI renders with the same pieces instead of re-creating them.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NubeIO/rubix-ui.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./scoped.css": "./dist/rubix-ui.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build && node scripts/assert-scoped-css.mjs"
  },
  "peerDependencies": {
    "@radix-ui/react-collapsible": "~1.1.0",
    "@radix-ui/react-dialog": "~1.1.0",
    "@radix-ui/react-dropdown-menu": "~2.1.0",
    "@radix-ui/react-menubar": "~1.1.0",
    "@radix-ui/react-popover": "~1.1.0",
    "@radix-ui/react-scroll-area": "~1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "~1.2.0",
    "lucide-react": ">=0.4.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@radix-ui/react-collapsible": "1.1.16",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-menubar": "1.1.20",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "1.2.12",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.2.9",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.0.0",
    "vitest": "^2.1.5"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
